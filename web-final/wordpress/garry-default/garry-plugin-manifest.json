{
  "schema_version": "2.3",
  "slug": "garry-default",
  "name": "GARRY – Výchozí zabezpečení webu",
  "plugin_version": "2.3.0",
  "framework_protocol": "2.4.0",
  "framework_minimum": "2.4.0",
  "icon": {
    "type": "dashicon",
    "value": "dashicons-shield"
  },
  "surfaces": [
    "admin-page"
  ],
  "admin": {
    "capability": "manage_options",
    "local_menu_slug": "garry-default"
  },
  "dependencies": {
    "required": [],
    "optional": [
      "wordfence",
      "updraftplus",
      "simple-cloudflare-turnstile",
      "two-factor",
      "fluent-smtp",
      "wp-mail-smtp",
      "simple-history",
      "all-in-one-wp-security-and-firewall",
      "patchstack"
    ]
  },
  "data": {
    "stores_personal_data": true,
    "settings_option_prefix": "garry_default_",
    "log_retention_days": 90,
    "uninstall_behavior": "delete-on-uninstall"
  },
  "external_origins": [
    "https://wordpress.org"
  ],
  "documentation": {
    "local_path": "README.md"
  },
  "security_profile": {
    "admin_assets_scope": "own-screen-only",
    "inline_assets": {
      "css": true,
      "js": false
    },
    "public_surfaces": [],
    "editor_custom_css": false,
    "performance_budget": {
      "max_public_items": 0,
      "bounded": true,
      "note": "admin-only, nothing rendered publicly"
    },
    "multisite_tested": "supported",
    "personal_data": {
      "stores_personal_data": true,
      "what": "wp_user_ids_in_findings_evidence_only",
      "retention_declared": true,
      "retention": "findings_indefinite_events_365d_evidence_90d"
    },
    "external_origins_verified": []
  }
}
